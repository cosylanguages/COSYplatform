{
  "name": "cosyplatform",
  "private": true,
  "scripts": {
    "test": "node --test",
    "check:legacy-tables": "node scripts/check-legacy-table-references.js",
    "check:content": "node scripts/check-content-integrity.js",
    "check:languages": "node scripts/check-lesson-languages.js",
    "check:protected": "node scripts/check_protected_keys.js",
    "stats:build": "node scripts/build-platform-stats.js",
    "stats:check": "node scripts/build-platform-stats.js --check",
    "audit:lexicon": "python3 scripts/audit-lexicon.py --cosydata \"${COSYDATA:-/tmp/COSYdata}\" --manuals \"${COSYMANUALS:-/tmp/COSYmanuals}\"",
    "review:vocab-ids": "python3 scripts/build-vocab-id-map.py --cosydata \"${COSYDATA:-/tmp/COSYdata}\" --course general-fr-b1 --write",
    "seed:workbooks": "node scripts/seed-workbooks.js",
    "validate": "npm run check:content && npm run check:languages && npm run check:protected && npm run stats:check && npm test"
  },
  "devDependencies": {
    "jsdom": "^29.1.1"
  }
}
