{
  "name": "cosyplatform-content",
  "version": "1.0.0",
  "description": "COSYplatform Content Repository",
  "private": true,
  "scripts": {
    "validate": "node scripts/check-content-integrity.js && node scripts/validate-curriculums.js && node scripts/validate-lessons.js && node scripts/sync-manifest-status.js --check && npm run check:stats && npm run check:cefr && npm run check:contrast && npm run test:founder && npm run test:classroom && npm run smoke",
    "smoke": "node scripts/smoke-pages.js",
    "build:pages": "node scripts/build-pages-site.js",
    "test:founder": "node scripts/test-founder.js",
    "test:classroom": "node scripts/test-classroom-security.js",
    "build:stats": "node scripts/build-stats.js",
    "check:stats": "node scripts/build-stats.js --check",
    "check:cefr": "node scripts/validate-cefr.js && python3 scripts/build-cefr-json.py --check",
    "check:contrast": "node scripts/check-contrast.js",
    "sync:manifest": "node scripts/sync-manifest-status.js",
    "check:manifest": "node scripts/sync-manifest-status.js --check",
    "check:integrity": "node scripts/check-content-integrity.js",
    "check:links": "node scripts/check-links.mjs"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "jsdom": "^29.1.1"
  }
}
