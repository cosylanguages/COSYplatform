      "title": "3. Vocabulary & Essential Chunks",
      "stage": "input",
      "duration": 50,
      "mode": "all",
      "elements": [
        {
          "type": "instruction",
          "content": "Core Active Vocabulary (5 items):"
        },
        {
          "type": "blockquote",
          "content": "lost — not able to be found. Example: I lost my wallet.\nstolen — taken illegally. Example: My bag was stolen.\nwallet — a small case for money and cards. Example: My wallet was in my bag.\nphone — a telephone. Example: My phone was stolen.\nbag — a container you carry things in. Example: My bag was stolen at the station."
        },
        {
          "type": "instruction",
          "content": "Essential Chunks & Functional Collocations:"
        },
        {
          "type": "blockquote",
          "content": "• I lost my ...\n• It was stolen.\n• Where is the police station?\n• Can you help me?\n• Here is my report."
        },
        {
          "type": "instruction",
          "content": "Vocabulary practice: choose the correct word."
        },
        {
          "type": "test",
          "content": "Which word means 'not able to be found'?",
          "options": [
            "lost",
            "stolen",
            "wallet"
          ]
        },
        {
          "type": "test",
          "content": "Which word means 'taken illegally'?",
          "options": [
            "stolen",
            "lost",
            "wallet"
          ]
        },
        {
          "type": "instruction",
          "content": "Complete the sentence with a word from the list."
        },
        {
