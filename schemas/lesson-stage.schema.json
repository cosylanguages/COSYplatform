{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://cosylanguages.com/schemas/lesson-stage.schema.json",
  "title": "CELTA-Style 6-Stage Lesson Unit",
  "description": "Schema for CELTA-style lesson units covering leadIn, meaningCheck, form, pronunciation, controlledPractice, freerPractice, and production stages.",
  "type": "object",
  "required": [
    "unitId",
    "title",
    "level",
    "language",
    "leadIn",
    "meaningCheck",
    "form",
    "pronunciation",
    "controlledPractice",
    "freerPractice",
    "production"
  ],
  "properties": {
    "unitId": {
      "type": "string",
      "description": "Unique identifier for the lesson unit."
    },
    "title": {
      "type": "string",
      "description": "The title of the grammar topic or lesson."
    },
    "level": {
      "type": "string",
      "description": "CEFR level code, e.g., A1, A2, B1."
    },
    "language": {
      "type": "string",
      "description": "ISO language code, e.g., en, fr, ru."
    },
    "leadIn": {
      "type": "object",
      "required": ["title", "content"],
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "mediaRefs": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "meaningCheck": {
      "type": "array",
      "description": "Array of choice-based CCQ objects.",
      "items": {
        "$ref": "ccq.schema.json"
      }
    },
    "instructionCheck": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question": { "type": "string" },
          "expectedAnswer": { "type": "string" },
          "attachedTo": {
            "type": "string",
            "enum": ["controlledPractice", "freerPractice", "production"]
          }
        },
        "required": ["question", "attachedTo"],
        "additionalProperties": false
      }
    },
    "form": {
      "type": "object",
      "required": ["title", "content"],
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "mediaRefs": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "pronunciation": {
      "type": "object",
      "required": ["title", "content"],
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "mediaRefs": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "controlledPractice": {
      "type": "array",
      "description": "Array of choice-based controlled practice items using the same shape as CCQs.",
      "items": {
        "$ref": "ccq.schema.json"
      }
    },
    "freerPractice": {
      "type": "object",
      "required": ["title", "content"],
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "links": { "type": "array", "items": { "type": "string" } },
        "mediaRefs": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "production": {
      "type": "object",
      "required": ["title", "content"],
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "links": { "type": "array", "items": { "type": "string" } },
        "mediaRefs": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
