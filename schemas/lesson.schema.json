{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CosyLanguages Lesson Schema",
  "type": "object",
  "required": ["id", "title", "level", "language", "slides"],
  "properties": {
    "id": { "type": "string" },
    "title": { "type": "string" },
    "level": { "type": "string", "enum": ["A0", "A1", "A2", "B1", "B2", "C1", "C2"] },
    "language": { "type": "string", "default": "en" },
    "defaultDuration": { "type": "integer", "enum": [50, 80, 110], "default": 50 },
    "defaultMode": { "type": "string", "enum": ["individual", "group", "all"], "default": "all" },
    "objectives": {
      "type": "array",
      "items": { "type": "string" }
    },
    "links": {
      "type": "object",
      "properties": {
        "vocabulary": {
          "type": "array",
          "items": { "type": "string" }
        },
        "grammar": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "topic_id": { "type": "string" },
              "manual_url": { "type": "string" },
              "practice_ref": { "type": "string" }
            }
          }
        },
        "communication": {
          "type": "array",
          "items": { "type": "string" }
        },
        "phonetics": { "type": "string" }
      }
    },
    "slides": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "stage": {
            "type": "string",
            "enum": [
              "lead-in",
              "warm-up",
              "recycling",
              "input",
              "listening",
              "reading-listening",
              "ccq-check",
              "grammar",
              "grammar-practice",
              "pronunciation",
              "controlled-practice",
              "freer-practice",
              "adaptation",
              "cool-down",
              "intro-greeting",
              "intro-icebreaker",
              "intro-goals",
              "intro-learning-style",
              "intro-diagnostic-speaking",
              "intro-course-recommendation",
              "intro-summary",
              "aloha-intro",
              "homework",
              "teacher-guide",
              "gabarit-core"
            ],
            "description": "Unified stage name for lesson slides, mapping to CELTA and platform lesson frameworks."
          },
          "duration": { "type": "integer", "enum": [50, 80, 110], "default": 50 },
          "mode": { "type": "string", "enum": ["individual", "group", "all"], "default": "all" },
          "teacherNotes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type", "content"],
              "properties": {
                "type": { "type": "string", "enum": ["instruction", "speech", "additional", "tapescript"] },
                "title": { "type": "string" },
                "content": { "type": "string" }
              }
            }
          },
          "elements": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["type"],
              "properties": {
                "type": { "type": "string" },
                "content": { "type": "string" },
                "src": { "type": "string" },
                "resourceId": { "type": "string" },
                "answers": { "type": "array" },
                "options": { "type": "array" }
              }
            }
          }
        }
      }
    }
  }
}
