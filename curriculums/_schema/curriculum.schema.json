{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "COSY Curriculum",
  "type": "object",
  "required": [
    "language",
    "course_type",
    "level",
    "units"
  ],
  "properties": {
    "language": {
      "type": "string"
    },
    "course_type": {
      "type": "string",
      "enum": [
        "general",
        "spoken",
        "discussion",
        "exam",
        "travelling",
        "professional",
        "relocation",
        "pronunciation"
      ]
    },
    "level": {
      "type": "string",
      "enum": [
        "A1",
        "A2",
        "B1",
        "B2",
        "C1",
        "C2"
      ]
    },
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "unit",
          "title",
          "lessons"
        ],
        "properties": {
          "unit": {
            "type": "integer"
          },
          "title": {
            "type": "string",
            "description": "Unit title in the target language"
          },
          "theme": {
            "type": "string",
            "pattern": "^t(0[1-9]|1[0-9]|2[0-2])$",
            "description": "Primary CEFR theme id matching cefr/data/themes.json (t01-t22). See docs/cefr-syllabus-and-vocabulary-architecture.md."
          },
          "secondaryThemes": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^t(0[1-9]|1[0-9]|2[0-2])$"
            },
            "description": "Additional CEFR theme ids touched by the unit, primary theme excluded."
          },
          "macroFunction": {
            "type": "string",
            "minLength": 3,
            "description": "The single communicative macro-function of the unit, written in the target language."
          },
          "lessons": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "lesson",
                "title"
              ],
              "properties": {
                "lesson": {
                  "type": "integer"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "vocab",
                    "grammar",
                    "gv",
                    "spoken",
                    "srev",
                    "exam",
                    "pronunciation",
                    "pron"
                  ]
                },
                "title": {
                  "type": "string"
                },
                "recycled": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "duration_minutes": {
                  "type": "integer"
                },
                "grammar": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "discourse": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "vocabulary": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "vocabularyIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[a-z]{2}:[a-z0-9-]+:(noun|verb|adjective|adverb|phrase|idiom|number|pronoun|preposition|determiner|conjunction|article)$"
                  },
                  "description": "COSYdata ids parallel to the human-readable vocabulary array; optional while the dictionary is backfilled."
                },
                "recycledIds": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "description": "Ids (grammar or vocabulary) deliberately reactivated from earlier lessons or levels."
                },
                "grammarThreads": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^T([1-9]|1[0-4])$"
                  },
                  "description": "Grammar threads T1-T14 touched by the lesson (architecture doc, section 5)."
                },
                "practice_types": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "speaking_percent": {
                  "type": "integer"
                },
                "teacher_notes": {
                  "type": "string"
                },
                "ageAdaptation": {
                  "type": "object",
                  "properties": {
                    "children": {
                      "type": "string"
                    },
                    "teens": {
                      "type": "string"
                    },
                    "adults": {
                      "type": "string"
                    },
                    "seniors": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                },
                "growingTask": {
                  "type": "object",
                  "description": "Cumulative task artifact. Policy A: Review/exam lessons (title containing 'review'/'exam' or type 'srev'/'exam') never receive growingTask. Policy B: selfPortrait is optional; omit for purely functional/conversational lessons (greetings, politeness formulas) and include dialogue only.",
                  "properties": {
                    "selfPortrait": {
                      "type": "string"
                    },
                    "dialogue": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                },
                "bigSpiralReview": {
                  "type": "boolean"
                },
                "bigSpiralScope": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  }
}
