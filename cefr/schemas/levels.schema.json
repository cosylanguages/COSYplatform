{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cosylanguages.com/cefr/schemas/levels.schema.json",
  "title": "CEFR Levels Schema",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "code",
      "level",
      "sublevel",
      "group",
      "nickname",
      "profile",
      "global_descriptor"
    ],
    "properties": {
      "code": {
        "type": "string",
        "pattern": "^[a-z0-9]+$"
      },
      "level": {
        "type": "string",
        "enum": ["A1", "A2", "B1", "B2", "C1", "C2"]
      },
      "sublevel": {
        "type": ["string", "null"],
        "enum": [null, "start", "p"]
      },
      "group": {
        "type": "string"
      },
      "nickname": {
        "type": "string"
      },
      "profile": {
        "type": "string"
      },
      "global_descriptor": {
        "type": "string"
      }
    },
    "additionalProperties": false
  }
}
