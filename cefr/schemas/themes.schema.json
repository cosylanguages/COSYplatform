{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cosylanguages.com/cefr/schemas/themes.schema.json",
  "title": "CEFR Themes Schema",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "name",
      "by_level"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^t\\d{2}$"
      },
      "name": {
        "type": "string"
      },
      "by_level": {
        "type": "object",
        "required": ["a1", "a2", "b1", "b2", "c1", "c2"],
        "properties": {
          "a1": { "type": "string" },
          "a2": { "type": "string" },
          "b1": { "type": "string" },
          "b2": { "type": "string" },
          "c1": { "type": "string" },
          "c2": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "additionalProperties": false
  }
}
