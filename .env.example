# Copy to .env.local. Only VITE_* variables are exposed to the browser.
# The Supabase anon key is public by design; security comes from RLS.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# "/" for a custom domain, "/<repo-name>/" for GitHub Pages.
VITE_BASE=/
# "browser" needs the 404.html redirect on GitHub Pages; "hash" needs nothing.
VITE_ROUTER=browser

# Published by COSYdata (see README, "Dictionary"). Leave empty until it exists.
VITE_COSYDATA_INDEX_URL=

# Optional TURN server for classroom video behind strict NATs.
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
