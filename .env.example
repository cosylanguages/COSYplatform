# Production values are committed in .env.production (public by design). Use .env.local to override locally.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# "hash" (default) works on any static host. "browser" gives clean URLs but needs host-side rewrites.
VITE_ROUTER=hash
# Base path override. Auto-detected on GitHub Actions ("/<repo>/"); "/" everywhere else.
VITE_BASE=

# JSON index published by COSYdata (see README, "Dictionary"). Leave empty until it exists.
VITE_COSYDATA_INDEX_URL=

# Optional TURN server for classroom video behind strict NATs.
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
